# Copy to .env for local development. Never commit a real .env — in Azure, every
# one of these is injected as a Container Apps env var, and every secret-shaped
# one (keys, connection strings) is a Key Vault reference, not a literal value.
# See infra/bicep/modules/container-app-api.bicep.

ENVIRONMENT=local
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://trialready:trialready@localhost:5433/trialready

# Local dev bypasses Entra token validation entirely. Never set this true anywhere
# but local.
AUTH_DISABLED_FOR_LOCAL_DEV=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ISSUER=
ENTRA_AUDIENCE=

# AI_PROVIDER=openai + OPENAI_API_KEY lets the classification agent run for
# real against api.openai.com before there's an Azure subscription. Switch to
# AI_PROVIDER=azure_openai (the production default in config.py) once
# infra/bicep/main.bicep is deployed — nothing else in the code changes.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini

# Leave blank locally to fall back to the in-repo fakes (see deps.py). Fill in
# once you have an Azure subscription and have run `infra/bicep/main.bicep`.
AZURE_OPENAI_ENDPOINT=
DOC_INTELLIGENCE_ENDPOINT=
STORAGE_ACCOUNT_URL=
KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
